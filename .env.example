# Cybersource sandbox credentials (HTTP Signature auth).
# Copy to .env.local and fill in. Never commit .env.local.
CYBS_RUN_ENVIRONMENT=apitest.cybersource.com
CYBS_MERCHANT_ID=
CYBS_KEY_ID=
CYBS_SHARED_SECRET=
# Optional: extra Unified Checkout target origins, comma-separated
UC_EXTRA_ORIGINS=
# Optional: Unified Checkout client version (default 0.31) and local origin (default http://localhost:3000)
UC_CLIENT_VERSION=
UC_LOCAL_ORIGIN=
# Optional: Unified Checkout payment types, comma-separated (default PANENTRY,CLICKTOPAY,GOOGLEPAY)
UC_PAYMENT_TYPES=
